<Page x:Class="CS_RobloxLauncher.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CS_RobloxLauncher.ViewModels"
        Title="Launcher" Height="500" Width="900"
        Background="#121212">

    <!--<Page.DataContext>
        <local:GameViewModel/>
    </Page.DataContext>-->

    <Grid>
        <Border Background="#1E1E1E"
                CornerRadius="15"
                Padding="0"
                Margin="30">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Image Source="{Binding SelectedGame.Thumbnail}"
                           Stretch="UniformToFill"/>
                    <Rectangle Fill="#80000000"/>
                </Grid>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="30">

                    <Grid Margin="0,0,0,20">

                        <Border x:Name="NeonBorder"
                            Padding="10,5"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="2">

                            <Border.BorderBrush>
                                <LinearGradientBrush x:Name="NeonBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#22C55E" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Border.Effect>
                                <DropShadowEffect Color="#22C55E"
                                    BlurRadius="25"
                                    ShadowDepth="0"
                                    Opacity="0.9"/>
                            </Border.Effect>

                            <TextBlock Text="{Binding SelectedGame.Name}"
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">

                                            <DoubleAnimation Storyboard.TargetName="NeonBrush"
                                                Storyboard.TargetProperty="GradientStops[0].Offset"
                                                From="-0.5" To="1"
                                                Duration="0:0:2"/>

                                            <DoubleAnimation Storyboard.TargetName="NeonBrush"
                                                Storyboard.TargetProperty="GradientStops[1].Offset"
                                                From="0" To="1"
                                                Duration="0:0:2"/>

                                            <DoubleAnimation Storyboard.TargetName="NeonBrush"
                                                Storyboard.TargetProperty="GradientStops[2].Offset"
                                                From="0" To="2"
                                                Duration="0:0:2"/>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                        </Border>

                    </Grid>

                    <Button Content="▶ Jouer"
                            Width="220"
                            Height="55"
                            FontSize="18"
                            Foreground="White"
                            Command="{Binding PlayCommand}"
                            Cursor="Hand">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#22C55E"/>
                                <Setter Property="BorderThickness" Value="0"/>

                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0"
                                                          ShadowDepth="0"
                                                          Opacity="0"/>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#16A34A"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect 
                                                    Color="#22C55E"
                                                    BlurRadius="30"
                                                    ShadowDepth="0"
                                                    Opacity="0.9"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#15803D"/>
                                    </Trigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>