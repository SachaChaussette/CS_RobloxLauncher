<Page x:Class="CS_RobloxLauncher.Views.GameWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Launcher"
      Background="#0F1116">

    <Grid>

        <Grid>
            <Image Source="{Binding SelectedGame.Thumbnail}"
           Stretch="Fill"/>

            <Grid Margin="0,150,0,0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>

                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
        </Grid>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.5"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="150" Height="150">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,150,150" RadiusX="5" RadiusY="5"/>
                </Border.Clip>

                <Image Source="{Binding SelectedGame.Thumbnail}"
                       Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                         Margin="30">

                <TextBlock Text="{Binding SelectedGame.Name}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <Border Background="#2A2D35"
                        CornerRadius="8"
                        Padding="8,2"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left">
                    <TextBlock Text="Maturity: Mild"
                               Foreground="#CFCFCF"
                               FontSize="12"/>
                </Border>

                <TextBlock Text="Gamer Robot Inc ✔"
                           Foreground="#8C8F96"
                           FontSize="12"
                           Margin="0,5,0,10"/>

                <StackPanel Orientation="Horizontal">

                    <Button Width="200"
                            Height="45"
                            Command="{Binding PlayCommand}"
                            Cursor="Hand">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#335FFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <TextBlock Text=" ▶"
                                                           FontSize="35"
                                                           Margin="0,0,8,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2F57E4"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#2446C7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Width="45"
                            Height="45"
                            Margin="10,0,0,0"
                            Background="#2A2D35"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand"
                            Content="⋯"
                            FontSize="20"
                            HorizontalAlignment="Right"/>
                </StackPanel>

            </StackPanel>
            
        </Grid>
        
        <Button Width="40"
            Height="40"
            Margin="15"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#CCFFFFFF"
            BorderThickness="0"
            Cursor="Hand">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="10">
                        <TextBlock Text="✕"
                            FontSize="16"
                            Foreground="Black"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Page>