<Page x:Class="RobloxLauncher.Views.ChartsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobloxLauncher.ViewModels"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
      mc:Ignorable="d"
        Title="ChartsPage" Height="1080" Width="1920">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#131313"/>
            <Setter Property="BorderBrush" Value="#131313"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5.0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#131313"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#131313"/>
            <Setter Property="BorderBrush" Value="#131313"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5.0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <DataTemplate x:Key="FilterTemplate">
            <ToggleButton>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="15" Text="{Binding Text}" TextWrapping="Wrap"/>
                    </WrapPanel>
                    <CheckBox  DockPanel.Dock="Right" IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </DockPanel>
            </ToggleButton>
        </DataTemplate>

    </Page.Resources>




    <!--<Page.DataContext>
        <local:ChartsPageViewModel/>
    </Page.DataContext>-->

    <Grid Background="#ffffff">

     
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height=".5*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#f7f7f8" >
            <Grid Margin="20,5,20,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width=".6*"/>
                    <ColumnDefinition Width=".6*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Assets/Images/Roblox-icon.png"/>
                <Button Grid.Column="1" Content="Charts" Command="{Binding HideErrorCommand}"/>
                <Button Grid.Column="2" Content="Marketplace" Command="{Binding ShowErrorCommand}"/>
                <Button Grid.Column="3" Content="Créer" Command="{Binding ShowErrorCommand}"/>
                <Button Grid.Column="4" Content="Robux" Command="{Binding ShowErrorCommand}"/>

                <Border Grid.Column="5" CornerRadius="10" Background="#edeef1" BorderThickness="0.1" BorderBrush="#131313">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/Assets/Images/search-icon.png"/>
                        <TextBox Background="Transparent" BorderThickness="0" Grid.Column="1" Text="Rechercher"/>
                    </Grid>
                </Border>

                <Border Grid.Column="7" Background="#335fff" CornerRadius="10" Margin="0,0,2,0">
                    <Button Content="S'inscrire" Foreground="White" Command="{Binding ShowErrorCommand}"/>
                </Border>
                <Border Grid.Column="8" BorderThickness="1" BorderBrush="Black"  Margin="2,0,0,0" CornerRadius="10">
                    <Button Content="Connexion" Command="{Binding ShowErrorCommand}"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Charts" FontSize="40" FontWeight="Bold" Margin="15,0,0,10" VerticalAlignment="Bottom"/>

        <TextBlock Grid.Row="2" Text="Populaire sur :" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Bottom"/>

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="20" Background="#f7f7f8" Margin="20,0,10,0">
                <ToggleButton Name="ToggleOrdinateurButton" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Text="Ordinateur" 
                                       Margin="0,0,10,0"/>
                            <Path Data="M0,0 L6,6 L12,0"
                                  Stroke="#666666"
                                  StrokeThickness="2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleOrdinateurButton}">
                            <Border BorderThickness="0.5" 
                                    Height="600" Width="400" 
                                    BorderBrush="Black"
                                    Background="#f7f7f8" 
                                    CornerRadius="10">
                                <!--<Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="9*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ItemsControl Grid.Column="1" ItemTemplate="{StaticResource FilterTemplate}">
                                        <ItemsControl.Items>
                                            <local:FilterItem Text="Tous les appareils"/>
                                            <local:FilterItem Text="Téléphone de niveau d'entrée de gamme"/>
                                            <local:FilterItem Text="Téléphone standard"/>
                                            <local:FilterItem Text="Tablette de niveau d'entrée de gamme"/>
                                            <local:FilterItem Text="Tablette standard"/>
                                            <local:FilterItem Text="Ordinateur"/>
                                            <local:FilterItem Text="Console"/>
                                            <local:FilterItem Text="RV"/>
                                        </ItemsControl.Items>
                                    </ItemsControl>
                                </Grid>-->
                            </Border>
                        </Popup>
                    </StackPanel>
                </ToggleButton>
            </Border>

            <Border Grid.Column="1" CornerRadius="20" Background="#f7f7f8" Margin="10,0,0,0">
                <ToggleButton Name="ToggleLocationsButton" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Text="Toutes les locations" 
                                       Margin="0,0,10,0"/>
                            <Path Data="M0,0 L6,6 L12,0"
                                  Stroke="#666666"
                                  StrokeThickness="2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleLocationsButton}">
                            <Border BorderThickness="1">
                                <TextBlock Background="LightBlue" Foreground="Blue" Padding="30">

                                </TextBlock>
                            </Border>
                        </Popup>
                    </StackPanel>
                </ToggleButton>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Text="Le top des tendance" FontSize="20" FontWeight="SemiBold" Margin="15,0,0,0" VerticalAlignment="Bottom"/>



        <ListBox Grid.Row="5"
         ItemsSource="{Binding AllGames}"
         Background="Transparent"
         BorderThickness="0"
         ScrollViewer.CanContentScroll="True"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.VirtualizationMode="Recycling">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel
                Orientation="Horizontal"
                ItemSize="160,250"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectGame,
                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Width="150"
                    Height="240"
                    Padding="5">

                        <StackPanel>
                            <Border Width="140"
                            Height="140"
                            CornerRadius="10">

                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                        Stretch="UniformToFill"/>
                                </Border.Background>

                            </Border>

                            <TextBlock Text="{Binding Name}"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               MaxHeight="45"
                               Margin="0,10,0,0"/>

                            <TextBlock Text="{Binding Players,
                               StringFormat='👤 {0} joueurs'}"
                               Margin="0,10,0,0"/>

                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>



        <Image Grid.Row="1"  Grid.RowSpan="6" 
               Height="1080"
               Width="2000"
               Visibility="{Binding VisibilityError}" 
               Source="/Assets/Images/799627bf-1821-4c6d-8905-6e63f4733e5c.png"/>

    </Grid>
</Page>
