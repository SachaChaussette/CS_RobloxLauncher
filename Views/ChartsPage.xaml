<Page x:Class="CS_RobloxLauncher.Views.ChartsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CS_RobloxLauncher.ViewModels"
        mc:Ignorable="d"
        Title="ChartsPage" Height="1080" Width="1920">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#131313"/>
            <Setter Property="BorderBrush" Value="#131313"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5.0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#131313"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#131313"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    
    <!--<Page.DataContext>
        <local:ChartsPageViewModel/>
    </Page.DataContext>-->

    <Grid Background="#ffffff">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height=".5*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#f7f7f8" >
            <Grid Margin="20,5,20,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width=".6*"/>
                    <ColumnDefinition Width=".6*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Assets/Images/Roblox-icon.png"/>
                <Button Grid.Column="1" Content="Charts"/>
                <Button Grid.Column="2" Content="Marketplace"/>
                <Button Grid.Column="3" Content="Créer"/>
                <Button Grid.Column="4" Content="Robux"/>

                <Border Grid.Column="5" CornerRadius="10" Background="#edeef1" BorderThickness="0.1" BorderBrush="#131313">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="/Assets/Images/search-icon.png"/>
                        <TextBox Background="Transparent" BorderThickness="0" Grid.Column="1" Text="Rechercher"/>
                    </Grid>
                </Border>

                <Border Grid.Column="7" Background="#335fff" CornerRadius="10" Margin="0,0,2,0">
                    <Button Content="S'inscrire" Foreground="White"/>
                </Border>
                <Border Grid.Column="8" BorderThickness="1" BorderBrush="Black"  Margin="2,0,0,0" CornerRadius="10">
                    <Button Content="Connexion"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Charts" FontSize="40" FontWeight="Bold" Margin="15,0,0,10" VerticalAlignment="Bottom"/>
        
        <TextBlock Grid.Row="2" Text="Populaire sur :" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Bottom"/>
        
        <TextBlock Grid.Row="4" Text="Le top des tendance" FontSize="20" FontWeight="SemiBold" Margin="15,0,0,0" VerticalAlignment="Bottom"/>

        <ScrollViewer Grid.Row="5">
           
            <WrapPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top">
                       
                <ItemsControl ItemsSource="{Binding AllGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectGame, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Vertical">
                                    <Border CornerRadius="10" Height="140" Width="140">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" 
                                                            Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    
                                    <Grid Margin="5,0,5,0"  Width="140" Height="90" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                    
                                        <WrapPanel Grid.Row="0" 
                                                   Margin="0,10,0,0" 
                                                   Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold" 
                                                       TextWrapping="WrapWithOverflow"/>
                                        </WrapPanel>
                                    
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Players, StringFormat='👤 {0} joueurs'}" 
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,10"/>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>
